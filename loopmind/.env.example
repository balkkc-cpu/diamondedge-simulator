# ──────────────────────────────────────────────────────────────────────────
# LoopMind environment variables
#
# Copy this file to `.env`. Every key is OPTIONAL — with no keys set the app
# runs fully in offline/mock mode (local auth, sample courses, mock weather,
# rule-based caddie). Add keys to light up the real integrations.
#
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the client bundle.
# ──────────────────────────────────────────────────────────────────────────

# Supabase — auth, profiles, saved rounds/clubs/stats.
# Create a project at https://supabase.com, run supabase/schema.sql, then paste
# the Project URL and anon/public key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI — rewrites caddie explanations into natural language.
# The shot DECISION is always made locally; this only affects wording.
# For production, proxy this through your own backend instead of shipping a key.
EXPO_PUBLIC_OPENAI_API_KEY=

# Weather — wind / temperature / humidity (e.g. OpenWeather).
EXPO_PUBLIC_WEATHER_API_KEY=

# Mapbox — only needed if you swap the built-in SVG HoleMap for a real basemap.
EXPO_PUBLIC_MAPBOX_TOKEN=
